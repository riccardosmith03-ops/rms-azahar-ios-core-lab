+// Copyright 2026 RMS contributors
+// Licensed under GPLv2 or any later version; see LICENSE.txt.
+#pragma once
+#include <cstdint>
+
+namespace LibRetro {
+
+// Output cadence is separate from the guest clock. Selection changes only at load.
+class RuntimeFramePump {
+public:
+    void Request(unsigned fps) noexcept { requested_fps = fps == 30 ? 30 : 60; }
+    void LatchForContent(bool vulkan) noexcept {
+        selected_fps = vulkan && requested_fps == 30 ? 30 : 60;
+        EndRun();
+    }
+    void ResetContent() noexcept { selected_fps = 60; EndRun(); }
+    unsigned OutputFps() const noexcept { return selected_fps; }
+    unsigned GuestFramesPerRun() const noexcept { return IsThirty() ? 2 : 1; }
+    bool IsThirty() const noexcept { return selected_fps == 30; }
+    bool IsRunning() const noexcept { return running; }
+    bool Failed() const noexcept { return failed; }
+    bool BeginRun() noexcept {
+        if (running) return false;
+        EndRun();
+        running = true;
+        return true;
+    }
+    bool ShouldPublish() const noexcept {
+        if (failed) return false;
+        if (!running || !IsThirty()) return true;
+        return !failed && publication_ready && !published;
+    }
+    bool IsLastGuestFrame() const noexcept {
+        return running && !failed && completed + 1 == GuestFramesPerRun();
+    }
+    bool PreparePublication() noexcept {
+        if (!running || failed || completed != GuestFramesPerRun() || published) return false;
+        publication_ready = true;
+        return true;
+    }
+    bool HasPublished() const noexcept { return published; }
+    bool TakeVideoFrame() noexcept {
+        if (!ShouldPublish()) return false;
+        if (running && IsThirty()) published = true;
+        return true;
+    }
+    bool CompleteGuestFrame() noexcept {
+        if (!running || failed || completed >= GuestFramesPerRun()) return false;
+        ++completed;
+        return true;
+    }
+    bool RunSucceeded() const noexcept {
+        return running && !failed && completed == GuestFramesPerRun() &&
+               (!IsThirty() || published);
+    }
+    void FailRun() noexcept { failed = true; }
+    void EndRun() noexcept {
+        running = false;
+        completed = 0;
+        published = false;
+        publication_ready = false;
+        failed = false;
+    }
+
+private:
+    unsigned requested_fps = 60;
+    unsigned selected_fps = 60;
+    unsigned completed = 0;
+    bool running = false;
+    bool published = false;
+    bool publication_ready = false;
+    bool failed = false;
+};
+
+// A frontend lease releases exactly one index; other images/metadata stay owned.
+class FrameSlotLease {
+public:
+    bool Configure(std::uint32_t value) noexcept {
+        mask = value;
+        ResetLease();
+        return mask != 0;
+    }
+    unsigned SlotCount() const noexcept {
+        unsigned count = 0;
+        for (auto bits = mask; bits != 0; bits >>= 1) ++count;
+        return count;
+    }
+    std::uint32_t Mask() const noexcept { return mask; }
+    bool Acquire(std::uint32_t current_mask, unsigned index) noexcept {
+        if (current_mask != mask || index >= 32 || (mask & (std::uint32_t{1} << index)) == 0) {
+            ResetLease();
+            return false;
+        }
+        leased_index = index;
+        acquired = true;
+        return true;
+    }
+    bool CanMutate(unsigned index) const noexcept {
+        return acquired && index == leased_index;
+    }
+    void ResetLease() noexcept { acquired = false; }
+private:
+    std::uint32_t mask = 0;
+    unsigned leased_index = 0;
+    bool acquired = false;
+};
+
+} // namespace LibRetro
