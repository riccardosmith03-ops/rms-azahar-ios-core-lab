+// RetroArch on an allocator/protection failure after JIT was selected, even at startup.
+extern "C" [[noreturn]] __attribute__((visibility("hidden"))) void rms_azahar_ios_jit_fail_closed(int phase, int native_error) noexcept {
+    char message[96];
+    const int length = std::snprintf(message, sizeof(message),
+                                    "RMS_CPU_JIT_FATAL phase=%d errno=%d; stopping process\n",
+                                    phase, native_error);
+    if (length > 0 && static_cast<std::size_t>(length) < sizeof(message)) {
