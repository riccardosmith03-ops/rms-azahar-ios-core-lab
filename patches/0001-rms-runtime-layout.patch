+        LibRetro::CheckInput(0, RETRO_DEVICE_JOYPAD, 0, RETRO_DEVICE_ID_JOYPAD_R3) > 0;
+    if (!emu_instance->runtime_layout.Update(mode, l3, r2, r3,
+            Settings::values.layout_option.GetValue() == Settings::LayoutOption::SingleScreen))
+        return false;
+
+    const auto layout = emu_instance->runtime_layout.TopOnly() ?
+        Settings::LayoutOption::SingleScreen : Settings::LayoutOption::SideScreen;
+    // Always show TOP in the single-screen view; do not inherit the old swap latch.
+    if (Settings::values.layout_option.GetValue() != layout ||
+        Settings::values.swap_screen.GetValue()) {
+        Settings::values.layout_option = layout;
+        Settings::values.swap_screen = false;
+        Core::System::GetInstance().ApplySettings();
+        emu_instance->emu_window->UpdateLayout();
+    }
+    return true;
+}
