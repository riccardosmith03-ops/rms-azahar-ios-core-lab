+// RMS experimental runtime layout policy. GPLv2 or later, as the surrounding core.
+#pragma once
+
+namespace LibRetro {
+enum class RuntimeLayoutHotkey { Disabled, L3, R2, R3, L3R2 };
+
+inline bool RuntimeLayoutConsumesL3(RuntimeLayoutHotkey mode) {
+    return mode == RuntimeLayoutHotkey::L3 || mode == RuntimeLayoutHotkey::L3R2;
+}
+inline bool RuntimeLayoutConsumesR2(RuntimeLayoutHotkey mode, bool l3) {
+    return mode == RuntimeLayoutHotkey::R2 ||
+           (mode == RuntimeLayoutHotkey::L3R2 && l3);
+}
+
+class RuntimeLayoutState {
+public:
+    void Reset() {
+        initialized = false;
+        armed = false;
+        held = false;
+    }
+    // Initial held buttons must be released before they can toggle a view.
+    bool Update(RuntimeLayoutHotkey mode, bool l3, bool r2, bool r3, bool configured_top_only) {
+        if (mode == RuntimeLayoutHotkey::Disabled) {
+            Reset();
+            return false;
+        }
+        if (!initialized || mode != previous_mode) {
+            Reset();
+            initialized = true;
+            previous_mode = mode;
+            top_only = configured_top_only;
+        }
+        const bool down = mode == RuntimeLayoutHotkey::L3 ? l3 :
+                          mode == RuntimeLayoutHotkey::R2 ? r2 :
+                          mode == RuntimeLayoutHotkey::R3 ? r3 : (l3 && r2);
+        if (!down)
+            armed = true;
+        if (down && !held && armed)
+            top_only = !top_only;
+        held = down;
+        return true;
+    }
+    bool TopOnly() const { return top_only; }
+private:
+    RuntimeLayoutHotkey previous_mode = RuntimeLayoutHotkey::Disabled;
+    bool initialized = false;
+    bool armed = false;
+    bool held = false;
+    bool top_only = false;
+};
+} // namespace LibRetro
