+// Optional runtime-only override: no options files, saves or emulated clocks are written.
+static bool UpdateRuntimeLayoutHotkey() {
+    const auto mode = LibRetro::settings.runtime_layout_hotkey;
+    if (mode != LibRetro::RuntimeLayoutHotkey::Disabled)
+        LibRetro::PollInput();
+    const bool l3 = mode != LibRetro::RuntimeLayoutHotkey::Disabled &&
+        LibRetro::CheckInput(0, RETRO_DEVICE_JOYPAD, 0, RETRO_DEVICE_ID_JOYPAD_L3) > 0;
+    const bool r2 = mode != LibRetro::RuntimeLayoutHotkey::Disabled &&
+        LibRetro::CheckInput(0, RETRO_DEVICE_JOYPAD, 0, RETRO_DEVICE_ID_JOYPAD_R2) > 0;
