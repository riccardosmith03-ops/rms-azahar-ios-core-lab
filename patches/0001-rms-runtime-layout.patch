+namespace {
+Core::IOSJit::ProbeResult ProbeIOSCodeMemoryOnWorker() {
+#if defined(__APPLE__) && TARGET_OS_IPHONE && (defined(__aarch64__) || defined(__arm64__))
+    struct Ops {
+        static constexpr std::size_t Size() noexcept { return 16 * 1024 * 1024; }
+        void* memory = nullptr;
+        int error = 0;
+        int LastError() const noexcept { return error; }
+        bool Allocate() {
+            memory = mmap(nullptr, Size(), PROT_READ | PROT_EXEC, MAP_ANON | MAP_PRIVATE, -1, 0);
+            if (memory == MAP_FAILED) { error = errno; memory = nullptr; return false; }
+            if (memory == nullptr) { error = ENOMEM; (void)munmap(memory, Size()); return false; }
+            return true;
+        }
+        bool MakeWritable() {
+            if (mprotect(memory, Size(), PROT_READ | PROT_WRITE) != 0) { error = errno; return false; }
+            return true;
+        }
+        void Emit(std::uint32_t instruction) {
+            auto* code = static_cast<volatile std::uint32_t*>(memory);
+            code[0] = instruction;
+            code[1] = 0xD65F03C0U; // ret
+        }
+        void Invalidate() { sys_icache_invalidate(memory, 2 * sizeof(std::uint32_t)); }
+        bool MakeExecutable() {
+            if (mprotect(memory, Size(), PROT_READ | PROT_EXEC) != 0) { error = errno; return false; }
+            return true;
+        }
+        std::uint64_t Execute() { return reinterpret_cast<std::uint64_t (*)()>(memory)(); }
+        bool Release() {
+            if (munmap(memory, Size()) != 0) { error = errno; return false; }
+            memory = nullptr;
+            return true;
+        }
+    };
+    Core::IOSJit::ProbeResult result{Core::IOSJit::ProbePhase::Worker, 0};
+    try {
+        std::thread worker([&result] { Ops ops; result = Core::IOSJit::ProbeMemory(ops); });
+        worker.join();
+    } catch (const std::system_error& error) {
+        return {Core::IOSJit::ProbePhase::Worker, error.code().value()};
+    }
+    return result;
+#else
+    return {Core::IOSJit::ProbePhase::Unsupported, 0};
+#endif
