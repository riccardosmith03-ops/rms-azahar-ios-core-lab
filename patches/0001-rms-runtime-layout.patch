+// Copyright 2026 RMS contributors
+// Licensed under GPLv3 or any later version; see LICENSE.txt.
+#pragma once
+#include <cstdint>
+#include <initializer_list>
+namespace Core::IOSJit {
+enum class ProbePhase : int { Ready=0, Allocate=1, Writable=2, Executable=3, Value=4, Release=5, Worker=6, Unsupported=7 };
+struct ProbeResult {
+    ProbePhase phase;
+    int native_error;
+    bool Passed() const noexcept { return phase == ProbePhase::Ready; }
+};
+// Ops is also used by the host policy tests. Failed transitions never emit or execute.
+template <typename Ops>
+ProbeResult ProbeMemory(Ops& ops) {
+    if (!ops.Allocate()) return {ProbePhase::Allocate, ops.LastError()};
+    const auto fail = [&ops](ProbePhase phase) {
+        const int error = ops.LastError();
+        ops.Release();
+        return ProbeResult{phase, error};
+    };
+    for (const auto value : {std::uint64_t{42}, std::uint64_t{43}}) {
+        if (!ops.MakeWritable()) return fail(ProbePhase::Writable);
+        ops.Emit(value == 42 ? 0xD2800540U : 0xD2800560U);
+        ops.Invalidate();
+        if (!ops.MakeExecutable()) return fail(ProbePhase::Executable);
+        if (ops.Execute() != value) return fail(ProbePhase::Value);
+    }
+    if (!ops.Release()) return {ProbePhase::Release, ops.LastError()};
+    return {ProbePhase::Ready, 0};
+}
+} // namespace Core::IOSJit
