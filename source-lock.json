  "scope": "Preserved RT/R3 and default-off CPUJIT; default60/load-latched Vulkan30 output with two full guest frames, independent per-index images and late publication; no throughput claim",
  "dependency_files": [
    {
      "path": "externals/oaknut/include/oaknut/code_block.hpp",
      "submodule": "externals/oaknut",
      "relative_path": "include/oaknut/code_block.hpp",
      "submodule_commit": "6b1d57ea7ed4882d32a91eeaa6557b0ecb4da152",
      "before_sha256": "c1b59e9d8a37775f8558fb3a0f7b34a6b7dbd2b2c13c088be65253c2223faa8a",
      "after_sha256": "06c94d906cb5da28d5124bb424255597f96c337a71e3a11596d1b84189177460"
    }
  ],
  "jit_policy": {
    "option": "citra_ios_cpu_jit",
    "default": "disabled",
    "opt_in": "jit_if_available",
    "preflight_failure": "FastInterp before monitor/CPU construction",
    "oaknut_failure_after_selection": "fixed phase/errno diagnostic then process _Exit(86); no live fallback or unwind",
    "shader_jit": "remains disabled on IOS",
    "same_process_permission_probe_run": false
  },
  "frame_pump_policy": {
    "option": "citra_rms_output_fps",
    "default": "60",
    "restart_required": true,
    "mode_30": "two complete guest frames per30Hz hostcall; both internal callbacks omitted; publish once after both RunLoops return",
    "frontend_sync": "one wait_sync_index/get_sync_index perhostcall; cached for both guest frames",
    "image_ownership": "independent image/view/FBO/persistent descriptor per raw sync index; resize only the released index; fixed mask; no modulo aliasing",
    "gpu_order": "Finish then WaitWorker then submit_mutex then frontendqueue lock then queue.waitIdle; initial, between frames and after both RunLoops before publication",
    "interface_binding": "immutable snapshot captured before Scheduler construction; refuse context/pointer/device/queue replacement before global writes",
    "quickstates_30": "unsupported; normal in-game saves unaffected",
    "soft_reset_30": "refused before Shutdown; close/reopen content to release all slots",
    "failure": "latched stop and frontendshutdown request; no timing-mismatched livefallback",
    "guest_cpu_clock_audio_changed": false,
    "pica_draw_work_skipped": false,
    "compiled_or_device_tested": false
  }
}
